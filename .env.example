# ==============================================================================
# CTS Cheque OCR - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Express Server Port
PORT=3000

# Python FastAPI PaddleOCR Model Service Base URL
# Default: http://localhost:8000
# Change to your deployed remote OCR endpoint (e.g. https://ocr-engine.yourdomain.com)
OCR_SERVICE_URL=http://localhost:8000
