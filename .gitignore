# Node & Python Dependencies
node_modules/
ocr-service/venv/
.venv/

# Build Outputs & Caches
*.tsbuildinfo
.jest_cache
.DS_Store
.now/
target/

# Environment Configuration
.env
.env.local

# Local SQLite Database Files (Do NOT push root runtime data to git)
/data/
*.db
*.sqlite
*.sqlite3

# Dynamic Local Storage Files (Do NOT push uploaded cheques to git)
/storage/*
!storage/.gitkeep

# Explicitly ensure client/data (source files) and client/dist (build output) are tracked by git
!client/data/
!client/dist/
!client/dist/**